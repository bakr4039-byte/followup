rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'; }
  function staff() { return signed() && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid)) && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.active == true; }
  function role() { return get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role; }
  function admin() { return staff() && role() == -1; }
  function fullRead() { return staff() && role() in [-1,8]; }
  function ownStaff(id) { return staff() && (role() in [0,1,2,3] && id.matches(role() == 0 ? 'c1-.*' : role() == 1 ? 'c2-.*' : role() == 2 ? 'c3-.*' : '(ba|cs)-.*') || role() in [4,5,6,7] && get(/databases/$(database)/documents/lessonCatalog/$(id)).data.teacher in get(/databases/$(database)/documents/config/monitors).data.teachers.get('m' + string(role()-4), [])); }
  function teacher() { return request.auth != null && request.auth.token.get('teacher',false) == true && get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.active == true; }
  function subTeacher(week, id) { return teacher() && exists(/databases/$(database)/documents/config/$('subs-' + week)) && get(/databases/$(database)/documents/config/$('subs-' + week)).data.get('map', {}).get(id, {}).get('t', '') == get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.get('scheduleName', '-'); }
  function ownTeacher(id) { return teacher() && get(/databases/$(database)/documents/teacherLessonAccess/$(request.auth.uid)).data.lessonIds.get(id,false) == true; }
  // Complete original records remain available as an immutable administrative archive.
  match /logs/{id} { allow read: if fullRead(); allow write: if false; }
  match /weeks/{week}/logs/{id} { allow read: if fullRead(); allow write: if false; }
  function supervisor(id) { return ownStaff(id) && role() in [0,1,2,3]; }
  function monitor(id) { return ownStaff(id) && role() in [4,5,6,7]; }
  function cleanCore() { return request.resource.data.keys().hasOnly(['absent','by','day','entry','present','rating','ratingMon','reason','recorded','status','sup','teacher','updatedAt','updatedBy','week','monBy','monAt','monUid','src','cleared','clearedAt','clearedBy']) && (resource == null || request.resource.data.keys().hasAll(resource.data.keys())); }
  function changed(key) { return resource == null ? key in request.resource.data : request.resource.data.diff(resource.data).affectedKeys().hasAny([key]); }
  function countValue(key) { let value = request.resource.data.get(key,null); return !changed(key) || value == null || value is int && value >= 0; }
  function ratingValue(key) { let value = request.resource.data.get(key,0); return !changed(key) || value is int && value >= 0 && value <= 5; }
  function validValues() { return countValue('present') && countValue('absent') && ratingValue('rating') && ratingValue('ratingMon') && (!changed('status') || request.resource.data.status in ['', 'pending', 'done', 'late', 'absent', 'tech']); }
  function validClearActor() { return !changed('clearedBy') && !changed('clearedAt') || admin() && request.resource.data.clearedBy == request.auth.uid && request.resource.data.clearedAt is string; }
  function responsibleActor() { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is string && request.resource.data.by == role(); }
  function validMonitorActor() { return request.resource.data.monUid == request.auth.uid && request.resource.data.monAt is string && request.resource.data.monBy == (admin() ? -1 : role()-4); }
  function adminCore() { return admin() && responsibleActor() && validClearActor() && (!(changed('ratingMon') || changed('monUid') || changed('monBy') || changed('monAt')) || validMonitorActor()); }
  function supervisorCore(id) { return supervisor(id) && responsibleActor() && (resource == null ? request.resource.data.get('ratingMon',0) == 0 && !request.resource.data.keys().hasAny(['monBy','monAt','monUid','clearedAt','clearedBy']) : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingMon','monBy','monAt','monUid','clearedAt','clearedBy'])); }
  function monitorCore(id) { return monitor(id) && validMonitorActor() && (resource == null ? request.resource.data.keys().hasOnly(['sup','day','teacher','week','ratingMon','monBy','monAt','monUid']) : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingMon','monBy','monAt','monUid'])); }
  function validNote() { return request.resource.data.keys().hasOnly(['text','updatedBy','updatedAt']) && request.resource.data.text is string && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is string; }
  match /recordWeeks/{week}/logs/{id} {
    allow get: if fullRead() || ownStaff(id) || ownTeacher(id) || subTeacher(week, id);
    allow list: if fullRead();
    allow create,update: if cleanCore() && validValues() && (adminCore() || supervisorCore(id) || monitorCore(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/vcNotes/{id} {
    allow get: if fullRead() || ownStaff(id) || ownTeacher(id) || subTeacher(week, id);
    allow list: if fullRead();
    allow create,update: if validNote() && (admin() || supervisor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/supNotes/{id} {
    allow get: if fullRead() || supervisor(id) || ownTeacher(id) || subTeacher(week, id);
    allow list: if fullRead();
    allow create,update: if validNote() && (admin() || supervisor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/monitorNotes/{id} {
    allow get: if fullRead() || monitor(id) || ownTeacher(id) || subTeacher(week, id);
    allow list: if fullRead();
    allow create,update: if validNote() && (admin() || monitor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/legacyNotes/{id} {
    allow get: if fullRead() || ownTeacher(id) || subTeacher(week, id);
    allow list: if fullRead();
    allow write: if false;
  }
  match /links/{id} { allow get: if fullRead() || ownStaff(id); allow list: if fullRead(); allow write: if admin() || ownStaff(id) && role() in [0,1,2,3]; }
  match /staffAccess/{uid} { allow get: if request.auth != null && request.auth.uid == uid || admin(); allow list,write: if admin(); }
  match /lessonCatalog/{id} { allow read: if staff(); allow write: if false; }
  match /config/main { allow read: if true; allow write: if admin(); }
  match /config/monitors { allow read: if true; allow write: if admin(); }
  match /config/secure { allow read: if true; allow write: if admin() && request.resource.data.enabled == true; }
  match /config/phones { allow read: if staff(); allow write: if admin(); }
  match /config/{id} { allow read: if admin() || id.matches('subs-.*') && (staff() || teacher()); allow write: if admin(); }
  match /meta/rules2 { allow get: if true; allow write: if false; }
  match /teacherProfiles/{uid} { allow get: if request.auth != null && request.auth.uid == uid && teacher(); }
  function teacherName() { return get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.get('scheduleName', '-'); }
  match /accountability/{id} {
    allow read: if admin() || teacher() && resource.data.teacher == teacherName();
    allow create, update: if admin();
    allow update: if teacher() && resource.data.teacher == teacherName() && resource.data.status == 'sent' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','replyAt','replyUid','status']) && request.resource.data.status == 'replied' && request.resource.data.replyUid == request.auth.uid && request.resource.data.replyAt == request.time && request.resource.data.reply is string && request.resource.data.reply.size() > 0 && request.resource.data.reply.size() <= 1500;
    allow delete: if false;
  }
  match /securityAudit/{event} { allow read: if admin(); allow write: if false; }
  match /securityLoginAttempts/{event} { allow read: if admin(); allow write: if false; }
  match /securityAlerts/{event} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read,write: if false; }
 }
}

