rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'; }
  function staff() { return signed() && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid)) && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.active == true; }
  function role() { return get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role; }
  function admin() { return staff() && role() == -1; }
  function accountabilityRecorder() { return signed() && exists(/databases/$(database)/documents/accountabilityRecorders/$(request.auth.uid)) && get(/databases/$(database)/documents/accountabilityRecorders/$(request.auth.uid)).data.active == true; }
  function fullRead() { return staff() && role() in [-1,8] || hasPersonalTasks() && get(/databases/$(database)/documents/personalTasks/$(request.auth.uid)).data.get('reports',false) == true; }
  function legacyStaff(id) { return staff() && (role() in [0,1,2,3] && id.matches(role() == 0 ? 'c1-.*' : role() == 1 ? 'c2-.*' : role() == 2 ? 'c3-.*' : '(ba|cs)-.*') || role() in [4,5,6,7] && get(/databases/$(database)/documents/lessonCatalog/$(id)).data.teacher in get(/databases/$(database)/documents/config/monitors).data.teachers.get('m' + string(role()-4), [])); }
  function hasPersonalTasks() { return employee() && exists(/databases/$(database)/documents/personalTasks/$(request.auth.uid)) && get(/databases/$(database)/documents/personalTasks/$(request.auth.uid)).data.active == true; }
  function lessonRole(id) { return id.matches('c1-.*') ? 0 : id.matches('c2-.*') ? 1 : id.matches('c3-.*') ? 2 : 3; }
  function catalogId(id) { return id.split('@')[0]; }
  function personalResponsible(id) { return hasPersonalTasks() && exists(/databases/$(database)/documents/lessonCatalog/$(catalogId(id))) && lessonRole(id) in get(/databases/$(database)/documents/personalTasks/$(request.auth.uid)).data.responsibilities; }
  function personalMonitor(id) { return hasPersonalTasks() && get(/databases/$(database)/documents/lessonCatalog/$(catalogId(id))).data.teacher in get(/databases/$(database)/documents/personalTasks/$(request.auth.uid)).data.monitorTeachers; }
  function ownStaff(id) { return legacyStaff(id) || personalResponsible(id) || personalMonitor(id); }
  function teacher() { return request.auth != null && request.auth.token.get('teacher',false) == true && get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.active == true; }
  function subTeacher(week, id) { return teacher() && exists(/databases/$(database)/documents/config/$('subs-' + week)) && get(/databases/$(database)/documents/config/$('subs-' + week)).data.get('map', {}).get(id, {}).get('t', '') == get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.get('scheduleName', '-'); }
  function ownTeacher(id) { return teacher() && get(/databases/$(database)/documents/teacherLessonAccess/$(request.auth.uid)).data.lessonIds.get(id,false) == true; }
  // Complete original records remain available as an immutable administrative archive.
  match /logs/{id} { allow read: if fullRead(); allow write: if false; }
  match /weeks/{week}/logs/{id} { allow read: if fullRead(); allow write: if false; }
  function supervisor(id) { return staff() && legacyStaff(id) && role() in [0,1,2,3] || personalResponsible(id); }
  function monitor(id) { return staff() && legacyStaff(id) && role() in [4,5,6,7] || personalMonitor(id); }
  function cleanCore() { return request.resource.data.keys().hasOnly(['absent','by','day','entry','present','rating','ratingMon','reason','recorded','status','sup','teacher','updatedAt','updatedBy','week','monBy','monAt','monUid','src','cleared','clearedAt','clearedBy']) && (resource == null || request.resource.data.keys().hasAll(resource.data.keys())); }
  function changed(key) { return resource == null ? key in request.resource.data : request.resource.data.diff(resource.data).affectedKeys().hasAny([key]); }
  function countValue(key) { let value = request.resource.data.get(key,null); return !changed(key) || value == null || value is int && value >= 0; }
  function ratingValue(key) { let value = request.resource.data.get(key,0); return !changed(key) || value is int && value >= 0 && value <= 5; }
  function validValues() { return countValue('present') && countValue('absent') && ratingValue('rating') && ratingValue('ratingMon') && (!changed('status') || request.resource.data.status in ['', 'pending', 'done', 'late', 'absent', 'tech']); }
  function validClearActor() { return !changed('clearedBy') && !changed('clearedAt') || admin() && request.resource.data.clearedBy == request.auth.uid && request.resource.data.clearedAt is string; }
  function responsibleActor(id) { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is string && (staff() && request.resource.data.by == role() || personalResponsible(id) && request.resource.data.by == lessonRole(id)); }
  function validMonitorActor() { return request.resource.data.monUid == request.auth.uid && request.resource.data.monAt is string && (staff() && request.resource.data.monBy == (admin() ? -1 : role()-4) || hasPersonalTasks() && request.resource.data.monBy == 0); }
  function adminCore(id) { return admin() && responsibleActor(id) && validClearActor() && (!(changed('ratingMon') || changed('monUid') || changed('monBy') || changed('monAt')) || validMonitorActor()); }
  function supervisorCore(id) { return supervisor(id) && responsibleActor(id) && (resource == null ? request.resource.data.get('ratingMon',0) == 0 && !request.resource.data.keys().hasAny(['monBy','monAt','monUid','clearedAt','clearedBy']) : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingMon','monBy','monAt','monUid','clearedAt','clearedBy'])); }
  function monitorCore(id) { return monitor(id) && validMonitorActor() && (resource == null ? request.resource.data.keys().hasOnly(['sup','day','teacher','week','ratingMon','monBy','monAt','monUid']) : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingMon','monBy','monAt','monUid'])); }
  function validNote() { return request.resource.data.keys().hasOnly(['text','updatedBy','updatedAt']) && request.resource.data.text is string && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is string; }
  function lessonDayKey(id) { return id.matches('.*-d0-.*') ? '0' : id.matches('.*-d1-.*') ? '1' : id.matches('.*-d2-.*') ? '2' : id.matches('.*-d3-.*') ? '3' : '4'; }
  function remoteLesson(week,id) { return !exists(/databases/$(database)/documents/weekModes/$(week)) || get(/databases/$(database)/documents/weekModes/$(week)).data.get('days',{}).get(lessonDayKey(id),get(/databases/$(database)/documents/weekModes/$(week)).data.mode) == 'remote'; }
  function validDayModes(d) { return d is map && d.keys().hasOnly(['0','1','2','3','4']) && d.get('0','remote') in ['remote','onsite'] && d.get('1','remote') in ['remote','onsite'] && d.get('2','remote') in ['remote','onsite'] && d.get('3','remote') in ['remote','onsite'] && d.get('4','remote') in ['remote','onsite']; }
  match /weekModes/{week} {
    allow read: if signed();
    allow create, update: if admin() && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.keys().hasOnly(['mode','days','updatedAt','updatedBy']) && request.resource.data.mode in ['remote','onsite'] && validDayModes(request.resource.data.get('days',{})) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    allow delete: if false;
  }
  match /recordWeeks/{week}/logs/{id} {
    allow get: if fullRead() || ownStaff(id) || remoteLesson(week,id) && (ownTeacher(id) || subTeacher(week, id));
    allow list: if fullRead();
    allow create,update: if remoteLesson(week,id) && cleanCore() && validValues() && (adminCore(id) || supervisorCore(id) || monitorCore(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/vcNotes/{id} {
    allow get: if fullRead() || ownStaff(id) || remoteLesson(week,id) && (ownTeacher(id) || subTeacher(week, id));
    allow list: if fullRead();
    allow create,update: if remoteLesson(week,id) && validNote() && (admin() || supervisor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/supNotes/{id} {
    allow get: if fullRead() || supervisor(id) || remoteLesson(week,id) && (ownTeacher(id) || subTeacher(week, id));
    allow list: if fullRead();
    allow create,update: if remoteLesson(week,id) && validNote() && (admin() || supervisor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/monitorNotes/{id} {
    allow get: if fullRead() || monitor(id) || remoteLesson(week,id) && (ownTeacher(id) || subTeacher(week, id));
    allow list: if fullRead();
    allow create,update: if remoteLesson(week,id) && validNote() && (admin() || monitor(id));
    allow delete: if false;
  }
  match /recordWeeks/{week}/legacyNotes/{id} {
    allow get: if fullRead() || remoteLesson(week,id) && (ownTeacher(id) || subTeacher(week, id));
    allow list: if fullRead();
    allow write: if false;
  }
  match /links/{id} { allow get: if fullRead() || ownStaff(id); allow list: if fullRead(); allow write: if admin() || supervisor(id); }
  match /staffAccess/{uid} { allow get: if request.auth != null && request.auth.uid == uid || admin(); allow list,write: if admin(); }
  match /lessonCatalog/{id} { allow read: if staff(); allow write: if false; }
  match /config/main { allow read: if true; allow write: if admin(); }
  match /config/monitors { allow read: if true; allow write: if admin(); }
  match /config/secure { allow read: if true; allow write: if admin() && request.resource.data.enabled == true; }
  match /config/phones { allow read: if staff(); allow write: if admin(); }
  match /config/{id} { allow read: if admin() || id.matches('subs-.*') && (staff() || teacher() || hasPersonalTasks()); allow write: if admin(); }
  match /meta/rules2 { allow get: if true; allow write: if false; }
  match /teacherProfiles/{uid} { allow get: if request.auth != null && request.auth.uid == uid && teacher(); }
  function teacherName() { return get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.get('scheduleName', '-'); }
  function employee() { return signed() && exists(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)) && get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.active == true; }
  function employeeName() { return get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.name; }
  function ownsAccountability() { return teacher() && resource.data.teacher == teacherName() || employee() && resource.data.teacher == employeeName(); }
  match /personalTasks/{uid} {
    allow get: if admin() || employee() && uid == request.auth.uid;
    allow list: if admin();
    allow create,update: if admin() && request.resource.data.keys().hasOnly(['active','responsibilities','monitorTeachers','reports','updatedAt','updatedBy']) &&
      request.resource.data.active is bool && request.resource.data.get('reports',false) is bool && request.resource.data.responsibilities is list && request.resource.data.responsibilities.size() <= 4 &&
      request.resource.data.responsibilities.hasOnly([0,1,2,3]) && request.resource.data.monitorTeachers is list && request.resource.data.monitorTeachers.size() <= 100 &&
      request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid &&
      get(/databases/$(database)/documents/employeeProfiles/$(uid)).data.active == true;
    allow delete: if false;
  }
  match /employeeProfiles/{uid} {
    allow get: if admin() || request.auth != null && request.auth.uid == uid && employee();
    allow list: if admin();
    allow create: if admin() && request.resource.data.keys().hasOnly(['name','title','memberId','phone','email','active','createdAt','createdBy']) &&
      request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150 &&
      request.resource.data.title is string && request.resource.data.title.size() <= 250 && request.resource.data.memberId.matches('admin-[0-9]+') &&
      request.resource.data.phone.matches('05[0-9]{8}') && request.resource.data.email == request.resource.data.phone + '@employees.alsahafa-followup.invalid' &&
      request.resource.data.active == true && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
    allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','phone','title']) && request.resource.data.active is bool && request.resource.data.phone.matches('05[0-9]{8}') && request.resource.data.title is string;
    allow delete: if false;
  }
  match /accountabilityRecorders/{uid} {
    allow get: if admin() || request.auth != null && request.auth.uid == uid;
    allow list: if admin();
    allow create: if admin() && request.resource.data.keys().hasOnly(['username','active','createdAt','createdBy']) &&
      request.resource.data.username is string && request.resource.data.username.matches('[A-Za-z0-9_-]{3,40}') &&
      request.resource.data.active == true && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
    allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool;
    allow delete: if false;
  }
  function validRecorderDraft() {
    let d = request.resource.data;
    return d.keys().hasOnly(['teacher','teacherFull','date','replyDue','time','monitor','items','other','details','teacherPhone','replyPhone','status','createdAt','createdBy']) &&
      d.teacher is string && d.teacher.size() > 0 && d.teacher.size() <= 150 && d.teacherFull is string && d.teacherFull.size() <= 200 &&
      d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.replyDue is string && d.replyDue.size() <= 10 &&
      d.time is string && d.time.size() <= 100 && d.monitor == 'مسؤول رصد المساءلات' &&
      d.items is list && d.items.size() <= 80 && d.other is string && d.other.size() <= 200 && d.details is string && d.details.size() <= 600 &&
      d.teacherPhone is string && d.teacherPhone.size() <= 20 && d.replyPhone is string && d.replyPhone.size() <= 20 &&
      d.status == 'sent' && d.createdAt == request.time && d.createdBy == request.auth.uid;
  }
  match /accountability/{id} {
    allow read: if admin() || ownsAccountability();
    allow create: if admin() && !request.resource.data.keys().hasAny(['archivedAt','archivePdf']) || accountabilityRecorder() && validRecorderDraft();
    allow update: if admin() && !resource.data.keys().hasAny(['archivedAt']) &&
      (!request.resource.data.keys().hasAny(['archivedAt']) ||
       resource.data.status == 'decided' && request.resource.data.status == 'decided' &&
       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivePdf','archiveFileName','archiveVersion','archiveClosedDate','archiveActor','archivedAt','archivedBy']) &&
       request.resource.data.archivedAt == request.time && request.resource.data.archivedBy == request.auth.uid &&
       request.resource.data.archiveActor == request.auth.uid && request.resource.data.archiveVersion == 1 &&
       request.resource.data.archivePdf is string && request.resource.data.archivePdf.size() > 0 && request.resource.data.archivePdf.size() < 910000);
    allow update: if ownsAccountability() && resource.data.status == 'sent' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','replyAt','replyUid','status']) && request.resource.data.status == 'replied' && request.resource.data.replyUid == request.auth.uid && request.resource.data.replyAt == request.time && request.resource.data.reply is string && request.resource.data.reply.size() > 0 && request.resource.data.reply.size() <= 1500;
    allow delete: if false;
  }
  // PDF acknowledgements. Each signer can create one immutable receipt from their own account.
  function signatureActor() { return staff() && role() >= -1 && role() <= 7 || teacher() || employee(); }
  function signatureKey() { return staff() ? 's:' + string(role()) : employee() ? 'e:' + employeeName() : 't:' + teacherName(); }
  function signatureReader(data) { return admin() || signatureActor() && signatureKey() in data.targetKeys; }
  function signatureStatement(kind) { return kind == 'approval' ? 'اطلعت وأوافق' : 'اطلعت وأقرّ بالاستلام'; }
  match /signDocuments/{documentId} {
    allow read: if signatureReader(resource.data);
    allow create: if admin() && request.resource.data.keys().hasOnly(['title','fileName','fileSize','fileHash','chunkCount','targets','targetKeys','kind','status','signedCount','createdAt','createdBy']) &&
      request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150 &&
      request.resource.data.fileName is string && request.resource.data.fileName.size() <= 255 &&
      request.resource.data.fileSize is int && request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 10485760 &&
      request.resource.data.fileHash is string && request.resource.data.fileHash.matches('[0-9a-f]{64}') &&
      request.resource.data.chunkCount is int && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 26 &&
      request.resource.data.targetKeys is list && request.resource.data.targetKeys.size() >= 1 && request.resource.data.targetKeys.size() <= 80 &&
      request.resource.data.targetKeys.toSet().size() == request.resource.data.targetKeys.size() &&
      request.resource.data.targets is map && request.resource.data.targets.keys().toSet() == request.resource.data.targetKeys.toSet() &&
      request.resource.data.kind in ['receipt','approval'] && request.resource.data.status == 'uploading' && request.resource.data.signedCount == 0 &&
      request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
    allow update: if admin() && resource.data.status == 'uploading' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','publishedAt']) &&
      request.resource.data.status == 'open' && request.resource.data.publishedAt == request.time;
    allow update: if signatureActor() && resource.data.status == 'open' && signatureKey() in resource.data.targetKeys &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signedCount']) && request.resource.data.signedCount == resource.data.signedCount + 1 &&
      !exists(/databases/$(database)/documents/signDocuments/$(documentId)/receipts/$(signatureKey())) &&
      getAfter(/databases/$(database)/documents/signDocuments/$(documentId)/receipts/$(signatureKey())).data.signedBy == request.auth.uid &&
      getAfter(/databases/$(database)/documents/signDocuments/$(documentId)/receipts/$(signatureKey())).data.signedAt == request.time;
    allow update: if admin() && resource.data.status == 'open' && resource.data.signedCount == resource.data.targetKeys.size() &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archivedAt','archivedBy','finalHash','finalChunkCount','finalSize']) && request.resource.data.status == 'archived' &&
      request.resource.data.archivedAt == request.time && request.resource.data.archivedBy == request.auth.uid &&
      request.resource.data.finalHash is string && request.resource.data.finalHash.matches('[0-9a-f]{64}') &&
      request.resource.data.finalChunkCount is int && request.resource.data.finalChunkCount >= 1 && request.resource.data.finalChunkCount <= 80 &&
      request.resource.data.finalSize is int && request.resource.data.finalSize > 0 && request.resource.data.finalSize <= 20971520;
    allow delete: if false;
    match /receipts/{signerKey} {
      function parent() { return get(/databases/$(database)/documents/signDocuments/$(documentId)).data; }
      allow read: if signatureReader(parent());
      allow create: if signatureActor() && signerKey == signatureKey() && signerKey in parent().targetKeys && parent().status == 'open' &&
        request.resource.data.keys().hasOnly(['name','title','statement','fileHash','signedBy','signedAt']) &&
        request.resource.data.name == parent().targets[signerKey].name && request.resource.data.title == parent().targets[signerKey].title &&
        request.resource.data.statement == signatureStatement(parent().kind) && request.resource.data.fileHash == parent().fileHash &&
        request.resource.data.signedBy == request.auth.uid && request.resource.data.signedAt == request.time &&
        getAfter(/databases/$(database)/documents/signDocuments/$(documentId)).data.signedCount == parent().signedCount + 1;
      allow update, delete: if false;
    }
    match /parts/{partId} {
      function parent() { return get(/databases/$(database)/documents/signDocuments/$(documentId)).data; }
      allow read: if signatureReader(parent()) && (!partId.matches('final-.*') || parent().status == 'archived');
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 550000 &&
        (partId.matches('original-[0-9]+') && parent().status == 'uploading' || partId.matches('final-[0-9]+') && parent().status == 'open' && parent().signedCount == parent().targetKeys.size());
      allow delete: if false;
    }
  }
  // Personal assignments: immutable originals, ordered account-owned signatures, shared final archive.
  function assignmentUser() { return employee(); }
  function assignmentReader(d) { return admin() || assignmentUser() && request.auth.uid in d.targetUids; }
  function assignmentFinisher(d) { return assignmentReader(d) && d.status == 'open' && d.signedCount == d.order.size(); }
  function assignmentOrder(d) {
    let directory = get(/databases/$(database)/documents/config/employeeDirectory).data.entries;
    let coordinator = directory['admin-2'].uid;
    let manager = directory['admin-1'].uid;
    let deputy = directory.get('admin-3', {}).get('uid', '');
    return directory['admin-2'].active == true && directory['admin-1'].active == true &&
      coordinator != manager && d.order is list && d.order.size() in [2,3,4] &&
      (d.order == (d.ownerUid in [coordinator,manager] ? [coordinator,manager] : [d.ownerUid,coordinator,manager]) ||
       (deputy != '' && deputy != coordinator && deputy != manager && directory['admin-3'].active == true &&
        d.order == (d.ownerUid in [coordinator,deputy,manager] ? [coordinator,deputy,manager] : [d.ownerUid,coordinator,deputy,manager]))) &&
      d.targetUids == d.order && d.targets is map && d.targets.keys().toSet() == d.order.toSet() &&
      get(/databases/$(database)/documents/employeeProfiles/$(d.ownerUid)).data.active == true &&
      get(/databases/$(database)/documents/employeeProfiles/$(d.ownerUid)).data.name == d.ownerName;
  }
  match /assignments/{assignmentId} {
    allow read: if assignmentReader(resource.data);
    allow create: if admin() && request.resource.data.keys().hasOnly(['title','fileName','fileSize','fileHash','chunkCount','ownerUid','ownerName','order','targetUids','targets','slots','status','signedCount','createdAt','createdBy']) &&
      request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150 &&
      request.resource.data.fileName is string && request.resource.data.fileName.size() <= 255 &&
      request.resource.data.fileSize is int && request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 10485760 &&
      request.resource.data.fileHash is string && request.resource.data.fileHash.matches('[0-9a-f]{64}') &&
      request.resource.data.chunkCount is int && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 26 &&
      request.resource.data.slots is list && request.resource.data.slots.size() in [2,3,4] &&
      assignmentOrder(request.resource.data) && request.resource.data.status == 'uploading' && request.resource.data.signedCount == 0 &&
      request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
    allow update: if admin() && resource.data.status == 'uploading' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','publishedAt']) &&
      request.resource.data.status == 'open' && request.resource.data.publishedAt == request.time;
    allow update: if assignmentUser() && resource.data.status == 'open' && resource.data.signedCount < resource.data.order.size() && resource.data.order[resource.data.signedCount] == request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signedCount']) && request.resource.data.signedCount == resource.data.signedCount + 1 &&
      !exists(/databases/$(database)/documents/assignments/$(assignmentId)/receipts/$(request.auth.uid)) &&
      getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/receipts/$(request.auth.uid)).data.signedBy == request.auth.uid &&
      getAfter(/databases/$(database)/documents/assignments/$(assignmentId)/receipts/$(request.auth.uid)).data.signedAt == request.time;
    allow update: if assignmentFinisher(resource.data) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archivedAt','archivedBy','finalHash','finalSize','finalChunkCount']) &&
      request.resource.data.status == 'archived' && request.resource.data.archivedAt == request.time && request.resource.data.archivedBy == request.auth.uid &&
      request.resource.data.finalHash.matches('[0-9a-f]{64}') && request.resource.data.finalSize is int && request.resource.data.finalSize > 0 && request.resource.data.finalSize <= 20971520 &&
      request.resource.data.finalChunkCount is int && request.resource.data.finalChunkCount >= 1 && request.resource.data.finalChunkCount <= 80;
    allow delete: if false;
    match /notifications/{notificationId} {
      function assignment() { return get(/databases/$(database)/documents/assignments/$(assignmentId)).data; }
      allow read: if admin();
      allow create: if admin() && assignment().status == 'open' && assignment().signedCount < assignment().order.size() &&
        request.resource.data.keys().hasOnly(['recipientUid','confirmedBy','confirmedAt','channel','stage','fileHash']) &&
        request.resource.data.recipientUid == assignment().order[assignment().signedCount] &&
        request.resource.data.stage == assignment().signedCount && request.resource.data.fileHash == assignment().fileHash &&
        request.resource.data.confirmedBy == request.auth.uid && request.resource.data.confirmedAt == request.time && request.resource.data.channel == 'whatsapp';
      allow update,delete: if false;
    }
    match /receipts/{uid} {
      function assignment() { return get(/databases/$(database)/documents/assignments/$(assignmentId)).data; }
      allow read: if assignmentReader(assignment());
      allow create: if assignmentUser() && uid == request.auth.uid && assignment().status == 'open' && assignment().signedCount < assignment().order.size() && assignment().order[assignment().signedCount] == uid &&
        request.resource.data.keys().hasOnly(['name','title','statement','signatureImage','fileHash','signedBy','signedAt']) &&
        request.resource.data.name == assignment().targets[uid].name && request.resource.data.title == assignment().targets[uid].title &&
        request.resource.data.statement == 'اطلعت على التكليف وأعتمده' && request.resource.data.fileHash == assignment().fileHash &&
        request.resource.data.signatureImage is string && request.resource.data.signatureImage.size() > 50 && request.resource.data.signatureImage.size() <= 95000 &&
        request.resource.data.signatureImage.matches('data:image/png;base64,[A-Za-z0-9+/=]+') &&
        request.resource.data.signedBy == uid && request.resource.data.signedAt == request.time &&
        getAfter(/databases/$(database)/documents/assignments/$(assignmentId)).data.signedCount == assignment().signedCount + 1;
      allow update,delete: if false;
    }
    match /parts/{partId} {
      function assignment() { return get(/databases/$(database)/documents/assignments/$(assignmentId)).data; }
      allow read: if assignmentReader(assignment()) && (!partId.matches('final-.*') || assignment().status == 'archived');
      allow create,update: if request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 550000 &&
        (admin() && assignment().status == 'uploading' && partId.matches('original-[0-9]+') || assignmentFinisher(assignment()) && partId.matches('final-[0-9]+'));
      allow delete: if false;
    }
  }
  match /securityAudit/{event} { allow read: if admin(); allow write: if false; }
  match /securityLoginAttempts/{event} { allow read: if admin(); allow write: if false; }
  match /securityAlerts/{event} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read,write: if false; }
 }
}


