rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- secure staff login (Firebase Auth accounts created from the platform settings) ----
    function secureOn() {
      return exists(/databases/$(database)/documents/config/secure)
        && get(/databases/$(database)/documents/config/secure).data.enabled == true;
    }
    function staffEmail() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'admin@staff.alsahafa-followup.invalid',
          'sup1@staff.alsahafa-followup.invalid', 'sup2@staff.alsahafa-followup.invalid',
          'sup3@staff.alsahafa-followup.invalid', 'sup4@staff.alsahafa-followup.invalid',
          'mon1@staff.alsahafa-followup.invalid', 'mon2@staff.alsahafa-followup.invalid',
          'mon3@staff.alsahafa-followup.invalid', 'mon4@staff.alsahafa-followup.invalid'
        ];
    }
    function adminEmail() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@staff.alsahafa-followup.invalid';
    }
    // old password-hash login: works only until secure login is switched on
    function legacyStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && !secureOn();
    }
    function staff() { return staffEmail() || legacyStaff(); }
    function admin() { return adminEmail() || legacyStaff(); }

    // ---- teachers (unchanged) ----
    function teacher() {
      return request.auth != null
        && request.auth.token.get('teacher', false) == true
        && get(/databases/$(database)/documents/teacherProfiles/$(request.auth.uid)).data.active == true;
    }
    function ownLesson(id) {
      return teacher()
        && get(/databases/$(database)/documents/teacherLessonAccess/$(request.auth.uid)).data.lessonIds.get(id, false) == true;
    }

    // marker the platform reads to confirm these rules are published
    match /meta/rules2 { allow get: if true; }

    match /logs/{id} {
      allow get: if staff() || ownLesson(id);
      allow list, write: if staff();
    }
    match /weeks/{week}/logs/{id} {
      allow get: if staff() || ownLesson(id);
      allow list, write: if staff();
    }
    match /links/{id} { allow read, write: if staff(); }

    // names are needed on the login screen
    match /config/main { allow read: if true; }
    match /config/monitors { allow read: if true; }
    match /config/secure { allow read: if true; }
    match /config/{id} {
      allow read: if staff();
      allow write: if admin();
    }

    match /teacherProfiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && teacher();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
